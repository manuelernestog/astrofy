---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

// Obtenemos todos los objetos de la carpeta store
const items = await getCollection("store");

// Extraemos todas las etiquetas unicas para crear los botones
const allTags = [...new Set(items.flatMap(item => item.data.tags || []))];
---

<BaseLayout sideBarActiveItemID="store">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Catálogo Completo</div>
  </div>

  <!-- Botones de Filtro -->
  <div class="flex flex-wrap gap-2 mb-8">
    <button class="btn btn-sm btn-active filter-btn" data-tag="all">Todos</button>
    {allTags.map((tag) => (
      <button class="btn btn-sm btn-outline filter-btn" data-tag={tag}>{tag}</button>
    ))}
  </div>

  <!-- Lista de Objetos -->
  <div id="catalog-list">
    {
      items.map((item) => (
        <div class="catalog-item" data-tags={JSON.stringify(item.data.tags || [])}>
          <HorizontalCard
            title={item.data.title}
            img={item.data.heroImage}
            desc={item.data.description}
            badge={item.data.badge}
            url={"/store/" + item.slug}
          />
          <div class="divider my-0" />
        </div>
      ))
    }
  </div>

  <!-- Script del Filtro -->
  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.catalog-item');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        // Cambiar el estilo visual del botón activo
        buttons.forEach(b => {
            b.classList.remove('btn-active');
            b.classList.add('btn-outline');
        });
        button.classList.remove('btn-outline');
        button.classList.add('btn-active');

        const selectedTag = button.getAttribute('data-tag');

        // Mostrar u ocultar los objetos según la etiqueta
        items.forEach(item => {
          const itemTags = JSON.parse(item.getAttribute('data-tags') || '[]');
          
          if (selectedTag === 'all' || itemTags.includes(selectedTag)) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
