---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Welcome to</div>
    <div class="text-5xl font-bold">My Private Catalog</div>
    <div class="text-3xl py-3 font-bold">Toys, clothing, and accessories</div>
    <div class="py-2">
      <text class="text-lg">
        Explore the full collection by browsing through the different categories. All items are detailed and ready to be filtered according to your preferences.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/projects">View Full Catalog</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Latest Additions</div>
  </div>

  <HorizontalCard
    title="Sample Item 1"
    img="/post_img.webp"
    desc="This is a sample description. Later, this will be connected to your actual files."
    url="/projects"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Sample Item 2"
    img="/post_img.webp"
    desc="This is a sample description."
    url="/projects"
  />
</BaseLayout>
