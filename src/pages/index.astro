---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import BandcampCard from "../components/BandcampCard.astro";
import { getCollection } from "astro:content";
import Bandcamp from "../components/Bandcamp.astro";
import { Image } from "astro:assets";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="flex flex-col items-center text-center pt-8 pb-16">
   <!-- Cinematic Wide Image -->
  <div class="w-full max-w-6xl">
    <Image 
      format="webp" 
      width={1200} 
      height={600} 
      class="w-full h-[300px] md:h-[500px] object-cover object-center rounded-2xl shadow-2xl border border-base-300" 
      src="/HeroHome.png" 
      alt="Paleo Poet Studios Art" 
    />
  </div>
  <!-- Unconfined Text Section -->
  <div class="w-full max-w-4xl mb-12">
    <div class="text-xl tracking-widest text-primary uppercase font-semibold mb-4">Ancient Art for the Modern Soul</div>
    <h1 class="text-3xl md:text-4xl font-black leading-tight text-base-content">
      Hand-knapped collector points paired with original poetry in song.
    </h1>
    <p class="text-xl mt-6 text-base-content/80 font-light max-w-2xl mx-auto">
      Welcome to the first collection release of Paleo Poet Studios. Every piece featured here is finite, hand-crafted, and available only in limited batches.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-6 justify-center">
      <a class="btn btn-primary px-8 text-base-100" href="/projects">Browse Knapped Art</a>
      <a class="btn btn-outline border-primary text-primary hover:bg-primary hover:text-base-100 px-8" href="/services">Browse Song Tracks</a>
    </div>
  </div>

 
  
</div>
