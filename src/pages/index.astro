---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Welcome to</div>
    <div class="text-5xl font-bold">Stella's Sissy Closet/div>
    <div class="text-3xl py-3 font-bold">Toys, clothing, and accessories</div>
    <div class="py-2">
      <text class="text-lg">
        Explore the full collection by browsing through the different categories. All items are detailed and ready to be filtered according to your preferences.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/store">View Full Catalog</a>
    </div>
  </div>

</BaseLayout>
