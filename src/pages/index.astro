---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there</div>
    <div class="text-5xl font-bold">I'm Sam Chen</div>
    <div class="text-3xl py-3 font-bold">Harvard CS & Math Student | AI Researcher</div>
    <div class="py-2">
      <text class="text-lg">
        I'm a Harvard student studying <b>Computer Science</b> and <b>Pure Mathematics</b>, currently doing research under
        Post Doc Peng and Professor Ullman at the <b>Cognitive, Cognition, and Development Lab</b>. My research focuses on
        <b>LLM interpretability and steering vectors</b>, working on safety and understanding how frontier models behave.
      </text>
    </div>
    <div class="py-2">
      <text class="text-lg">
        Beyond research, I'm passionate about building products that democratize access to education and opportunities.
        I've co-founded <b>Libertas Debate Academy</b> (6-figure revenue in year 1) and <b>IvyLine</b> (scaled to 500 users in 5 days),
        and I serve as a Senior Software Engineer at <b>Harvard Tech for Social Good</b> and Campus Lead for <b>Cursor</b>.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/in/sam-chen-massachusetts" target="_blank"> Let's connect!</a>
      <a href="https://github.com/SamC1249" target="_blank" class="btn btn-outline ml-5">
        View my GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="IvyLine Search"
    img="/post_img.webp"
    desc="Full-stack web app democratizing college advice with semantic search for 200+ opportunities. Scaled to 500 users in 5 days with 100K LinkedIn impressions. Built with Grok 3, Xenova embeddings, and Vercel."
    url="https://github.com/SamC1249"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SafeRoute (HackHarvard)"
    img="/post_img.webp"
    desc="Chrome extension analyzing route safety using TensorFlow-based ML backend. Combines live-time and historical data for safety analysis rather than speed optimization."
    url="https://github.com/SamC1249"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="NewsAI (Anthropic Hackathon)"
    img="/post_img.webp"
    desc="Next.js app analyzing news bias and surfacing balanced perspectives. Built user interface and backend to identify source disagreement using NLP methods."
    url="https://github.com/SamC1249"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
